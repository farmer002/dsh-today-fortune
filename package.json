{
  "name": "dsh-today-fortune",
  "version": "1.0.0",
  "description": "A cartoon temple orb floating in the DSH overlay: pick a censer, draw a lot slip and read today's almanac in plain modern language.",
  "license": "MIT",
  "author": "Alfarmer-001",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "fortune",
    "almanac",
    "黄历",
    "今日运势",
    "ui"
  ],
  "homepage": "https://github.com/Alfarmer-001/dsh-today-fortune#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alfarmer-001/dsh-today-fortune.git"
  },
  "bugs": {
    "url": "https://github.com/Alfarmer-001/dsh-today-fortune/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
